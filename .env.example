# Copy to .env (gitignored). Local defaults shown; Supabase values come later.
DATABASE_URL=postgresql:///bolagsvakt
BOLAGSVAKT_ENV=dev
# Local: any random string of 32+ characters. Supabase: Project Settings -> API -> JWT secret.
SUPABASE_JWT_SECRET=
